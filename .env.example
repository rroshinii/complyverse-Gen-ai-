# ---------------------------------------------------------------------------
# ComplyVerse environment variables
# Copy this file to .env for local development:  cp .env.example .env
# In Vercel, set these under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Google Gemini API key used by all four agents (Ingestion, Graph, Simulation,
# Evidence). Get one at https://aistudio.google.com/app/apikey
#
# OPTIONAL: if this is left unset, every agent automatically falls back to a
# deterministic, heuristic response (no API calls made) so the app remains
# fully demoable without any key configured. Set it to enable live Gemini
# calls in the "live" mode reported by GET /api/status.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# The following are set automatically by their respective platforms and do
# NOT need to be added manually - listed here only for reference.
# ---------------------------------------------------------------------------

# Set to "1" automatically by Vercel at build/runtime. Used by lib/graphStore.ts
# to decide whether to persist state under /tmp (serverless-safe) instead of
# ./data (used for local development only).
# VERCEL=1

# Local dev server port (server.ts / npm run dev). Defaults to 3000.
# PORT=3000

# Set to "production" automatically by Vite/Vercel during production builds.
# NODE_ENV=development
